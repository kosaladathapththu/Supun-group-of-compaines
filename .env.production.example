# Copy to .env and fill in deployment-specific values. Never commit .env.
NODE_ENV=production
PORT=3001

# Same-origin API. Use an absolute HTTPS URL only for a separate backend host.
VITE_API_URL=/api

# Generate a unique secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE-THIS-TO-A-UNIQUE-RANDOM-SECRET

# Paths resolve relative to the project root unless absolute paths are supplied.
DATABASE_PATH=./server/database.sqlite
UPLOAD_DIR=./server/uploads
MAX_FILE_SIZE=10485760

# Used only when creating the first administrator. Minimum 12 characters.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@supungroup.lk
ADMIN_PASSWORD=

# Comma-separated frontend origins; required when frontend and API use different hosts.
CORS_ORIGIN=https://supuncompanies.com,https://www.supuncompanies.com
# Set only for a trusted local reverse proxy, such as Nginx.
# TRUST_PROXY=loopback
